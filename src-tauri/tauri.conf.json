{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNSChecker",
  "version": "0.1.0",
  "identifier": "com.dnschecker.desktop",
  "build": {
    "beforeDevCommand": "npm run vite -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DNSChecker",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
